rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // 이메일로 친구를 찾으려면 로그인한 사용자는 누구나 프로필(닉네임, 이메일)을 읽을 수 있어야 해요
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 10;

      // 친구 목록: 친구 요청이 있어야만 서로의 목록에 추가할 수 있어요
      match /friends/{fid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && (
          (request.auth.uid == uid && exists(/databases/$(database)/documents/friendRequests/$(fid + '_' + uid)))
          || (request.auth.uid == fid && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + fid)))
        );
        allow delete: if request.auth != null && request.auth.uid in [uid, fid];
      }

      // 분석 사건: 본인만 읽어요. 쓰기는 서버(analyzeDiary)만
      match /events/{eid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // 일기: 본인만 읽고 쓸 수 있어요 (백업, 일기 저장에서 사용)
      match /diaries/{did} {
        function isFriendOfOwner() {
          return exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
        }

        // 일기: 본인, 그리고 '친구 공개'면 친구도 읽을 수 있어요
        allow read: if request.auth != null && (
          request.auth.uid == uid
          || (resource.data.visibility == 'friends' && isFriendOfOwner())
        );
        allow write: if request.auth != null && request.auth.uid == uid;

        // 공감: 문서 ID 가 누른 사람 uid 라 한 사람당 한 번만 눌려요
        match /likes/{liker} {
          allow read: if request.auth != null && (request.auth.uid == uid || isFriendOfOwner());
          allow write: if request.auth != null && request.auth.uid == liker
            && (request.auth.uid == uid || isFriendOfOwner());
        }

        // 댓글: 친구만 쓰고, 지우는 건 쓴 사람과 일기 주인
        match /comments/{cid} {
          allow read: if request.auth != null && (request.auth.uid == uid || isFriendOfOwner());
          allow create: if request.auth != null
            && request.resource.data.uid == request.auth.uid
            && (request.auth.uid == uid || isFriendOfOwner())
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 1
            && request.resource.data.body.size() <= 200;
          allow delete: if request.auth != null
            && (request.auth.uid == resource.data.uid || request.auth.uid == uid);
        }
      }
    }

    // 문서 ID는 "보낸사람uid_받는사람uid"
    match /friendRequests/{id} {
      allow read, delete: if request.auth != null
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.from != request.resource.data.to
        && id == request.resource.data.from + '_' + request.resource.data.to;
    }

        // 알림 토큰: 본인만 (users 문서는 다른 사람도 읽을 수 있어서 따로 둬요)
    match /pushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 관리자 목록: 콘솔에서 직접 추가, 본인 여부만 확인할 수 있어요
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    match /notices/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}