{
  "functions": {
    "source": "backend",
    "predeploy": ["npm --prefix backend run build"]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "ppittul",
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
